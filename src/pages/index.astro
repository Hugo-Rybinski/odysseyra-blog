---
import '@fontsource-variable/overpass';
import '../styles/global.css';
import { base, ui } from '../i18n';
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Odysseyra</title>
    <meta name="description" content={`${ui.fr.tagline} / ${ui.en.tagline}`} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="alternate" hreflang="fr" href={`${base}/fr/`} />
    <link rel="alternate" hreflang="en" href={`${base}/en/`} />
    <script is:inline define:vars={{ base }}>
      const prefersFr = (navigator.languages || [navigator.language]).some((l) => /^fr\b/i.test(l));
      location.replace(`${base}/${prefersFr ? 'fr' : 'en'}/`);
    </script>
  </head>
  <body>
    <main class="pick">
      <img src={`${base}/logo.svg`} alt="" width="64" height="64" />
      <h1>Odysseyra</h1>
      <p><a href={`${base}/fr/`} hreflang="fr" lang="fr">Français</a> · <a href={`${base}/en/`} hreflang="en" lang="en">English</a></p>
    </main>
    <style>
      .pick { min-height: 100vh; display: grid; place-content: center; justify-items: center; gap: 12px; }
      h1 { letter-spacing: 0.16em; text-transform: uppercase; font-size: 1.25rem; }
    </style>
  </body>
</html>
