---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('posts', ({ data }) => import.meta.env.DEV || !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="Odysseyra">
  <div class="wide">
    <h1>Odysseyra</h1>
    <p class="meta">Notes, photos and maps from the road.</p>
    <ul class="grid">
      {
        posts.map((post) => (
          <li>
            <a href={`${import.meta.env.BASE_URL}/posts/${post.id}/`}>
              <Image src={post.data.cover} alt={post.data.coverAlt} width={600} height={400} />
              <h2>{post.data.title}</h2>
            </a>
            <p class="meta">
              {post.data.location && <>{post.data.location} · </>}
              {post.data.date.toLocaleDateString('en', { dateStyle: 'long' })}
            </p>
            <p>{post.data.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .grid { list-style: none; padding: 0; display: grid; gap: 2rem; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); }
  .grid img { border-radius: 0.5rem; object-fit: cover; width: 100%; aspect-ratio: 3 / 2; }
  .grid a { text-decoration: none; color: inherit; }
  h2 { font-size: 1.3rem; margin: 0.75rem 0 0.25rem; }
</style>
