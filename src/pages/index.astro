---
import '@fontsource-variable/overpass';
import '../styles/global.css';
import { base, ui } from '../i18n';
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Odysseyra</title>
    <meta name="description" content={`${ui.fr.tagline} / ${ui.en.tagline}`} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="alternate" hreflang="fr" href={`${base}/fr/`} />
    <link rel="alternate" hreflang="en" href={`${base}/en/`} />
    <script is:inline define:vars={{ base }}>
      const prefersFr = (navigator.languages || [navigator.language]).some((l) => /^fr\b/i.test(l));
      location.replace(`${base}/${prefersFr ? 'fr' : 'en'}/`);
    </script>
  </head>
  <body>
    <div class="sheet"><div class="sheet-inner">
      <main class="pick">
        <img src={`${base}/logo.svg`} alt="" width="64" height="64" />
        <h1>Odysseyra</h1>
        <ul>
          <li><a href={`${base}/fr/`} hreflang="fr" lang="fr"><strong>Français</strong><small>{ui.fr.tagline}</small></a></li>
          <li><a href={`${base}/en/`} hreflang="en" lang="en"><strong>English</strong><small>{ui.en.tagline}</small></a></li>
        </ul>
      </main>
    </div></div>
    <style>
      /* Shown only without scripts (the page redirects by browser language): the two sheet indexes, as a legend's
         export boxes. */
      .pick { min-height: inherit; display: grid; place-content: center; justify-items: center; gap: 16px; padding: 40px 16px; }
      h1 { font-size: 14px; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; }
      ul { list-style: none; margin: 8px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 9px; width: min(520px, 100%); }
      a { display: grid; gap: 2px; height: 100%; padding: 10px 14px; border: 1px solid var(--ink); background: var(--paper); text-decoration: none; line-height: 1.3; }
      a:hover { background: var(--ink); color: var(--paper); }
      a:hover small { color: rgb(255 255 255 / 0.75); }
      strong { font-size: 15px; }
      small { color: var(--ink-3); font-size: 13px; }
    </style>
  </body>
</html>
