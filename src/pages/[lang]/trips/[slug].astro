---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RunningHead from '../../../components/RunningHead.astro';
import Progress from '../../../components/Progress.astro';
import SheetMap from '../../../components/SheetMap.astro';
import Photo from '../../../components/Photo.astro';
import Plates from '../../../components/Plates.astro';
import Pair from '../../../components/Pair.astro';
import Region from '../../../components/Region.astro';
import Tip from '../../../components/Tip.astro';
import Review from '../../../components/Review.astro';
import Good from '../../../components/Good.astro';
import Redo from '../../../components/Redo.astro';
import Place from '../../../components/Place.astro';
import Day from '../../../components/Day.astro';
import Before from '../../../components/Before.astro';
import Icon from '../../../components/Icon.astro';
import IndexStrip from '../../../components/IndexStrip.astro';
import Foot from '../../../components/Foot.astro';
import { render } from 'astro:content';
import { languages, t, tripUrl, otherLang, formatDateRange, formatDate, base, idx, dayRange, type Lang } from '../../../i18n';
import { getPublishedTrips, getTripView, formatDegrees, mapPoints } from '../../../lib/trips';

export async function getStaticPaths() {
  const published = await getPublishedTrips();
  return languages.flatMap((lang) =>
    published.map(({ trip, texts }, i) => ({
      params: { lang, slug: trip.id },
      props: {
        trip,
        text: texts[lang],
        newer: published[i - 1] && { slug: published[i - 1].trip.id, title: published[i - 1].texts[lang].data.title },
        older: published[i + 1] && { slug: published[i + 1].trip.id, title: published[i + 1].texts[lang].data.title },
      },
    })),
  );
}

const { trip, text, newer, older } = Astro.props;
const lang = Astro.params.lang as Lang;
const s = t(lang);
const view = await getTripView(trip, lang, text.body);
Astro.locals.trip = view;
const { Content } = await render(text);

const { data } = view;
const cover = view.photos.get(data.cover)!;
const days = Math.round((data.end.valueOf() - data.start.valueOf()) / 86_400_000) + 1;
const sheet = `${s.sheet} ${String(data.sheet).padStart(2, '0')} · ${data.country[lang]}`;
const alternates = Object.fromEntries(languages.map((l) => [l, tripUrl(l, view.slug)]));
const fileBase = `odysseyra-${view.slug}-${lang}`;
const exportsBase = `${tripUrl(lang, view.slug)}`;
const routes = data.regions.map((r) => ({ id: r.id, name: r.name[lang], href: `#${r.id}`, segments: r.route }));
// The trip map carries the overnight stages; every stop and detour is on its region map.
const points = mapPoints(view).filter((p) => p.kind !== 'sight' && p.kind !== 'detour');
const nf = new Intl.NumberFormat(lang);
// Google Maps directions take an origin, a destination and up to 9 stops: the overnight stages fit.
const stages = view.points.filter((p) => p.kind === 'stage').map((p) => p.at.join(','));
const via = stages.slice(1, -1);
const step = Math.ceil(via.length / 9) || 1;
const googleStages = `https://www.google.com/maps/dir/?api=1&travelmode=driving&origin=${stages[0]}&destination=${stages.at(-1)}&waypoints=${via.filter((_, i) => i % step === 0).slice(0, 9).join('|')}`;
const allCoords = view.points.map((p) => `${p.ref}${p.name}\t${p.at[0].toFixed(5)}, ${p.at[1].toFixed(5)}`).join('\n');
---

<BaseLayout lang={lang} title={`${text.data.title} — Odysseyra`} description={text.data.description} alternates={alternates}>
  <RunningHead lang={lang} otherHref={tripUrl(otherLang(lang), view.slug)} sheet={sheet} coords={formatDegrees(view.center)} />
  <Progress lang={lang} />

  <main id="main" data-uid={`SHT${idx(data.sheet)}-${data.start.getUTCFullYear()}-${data.code}`}>
    <div class:list={['top', cover.orientation]}>
      <div class="hero-plate">
        <Photo id={data.cover} loading="eager" />
      </div>

      <div class="cartouche">
        <h1>{text.data.title}</h1>
        <div class="summary">
        <p class="lede">{text.data.description}</p>
        <dl class="facts">
          <div><dt class="label">{s.dates}</dt><dd>{formatDateRange(lang, data.start, data.end)}</dd></div>
          <div><dt class="label">{s.days}</dt><dd>{days}</dd></div>
          <div><dt class="label">{s.regions}</dt><dd>{data.regions.length}</dd></div>
          <div><dt class="label">{s.distance}</dt><dd>{nf.format(view.distanceKm)} {s.km}</dd></div>
          {data.travellers && <div><dt class="label">{s.travellers}</dt><dd>{data.travellers}</dd></div>}
          {
            data.costPerPerson && (
              <div class="cost">
                <dt class="label">{s.costPerPerson}</dt>
                <dd>
                  {new Intl.NumberFormat(lang, { style: 'currency', currency: data.costPerPerson.currency, maximumFractionDigits: 0 }).format(data.costPerPerson.amount)}
                  <span class="note">{s.costNote}</span>
                </dd>
              </div>
            )
          }
        </dl>
        {
          data.written && (
            <p class="stamp">
              {s.written} <time datetime={data.written.toISOString().slice(0, 10)}>{formatDate(lang, data.written)}</time>
              {data.updated && data.updated > data.written && (
                <>
                  <i class="sep" aria-hidden="true"></i>
                  {s.updated} <time datetime={data.updated.toISOString().slice(0, 10)}>{formatDate(lang, data.updated)}</time>
                </>
              )}
            </p>
          )
        }
        </div>
      </div>

      <div class="legend">
        <h2 class="label">{s.legend}</h2>
        <ul class="symbols">
          <li><span class="sym route" aria-hidden="true"></span>{s.legendRoute}</li>
          <li><span class="badge stay" aria-hidden="true"><span>01</span></span>{s.legendStage}</li>
          <li><span class="badge stop" aria-hidden="true"><span>01</span></span>{s.legendSight}</li>
          <li><span class="sym detour" aria-hidden="true"></span>{s.legendDetour}</li>
          <li><span class="sym approx" aria-hidden="true"></span>{s.legendApprox}</li>
        </ul>
        <h2 class="label take">{s.takeRoute}</h2>
        <div class="exports">
          <a class="btn" href={`${exportsBase}route.gpx`} download={`${fileBase}.gpx`} title={s.gpxHint}>
            <Icon name="download" size={16} /><span><strong>{s.gpx}</strong><small>{s.gpxHint}</small></span>
          </a>
          <a class="btn" href={`${exportsBase}route.kml`} download={`${fileBase}.kml`} title={s.kmlHint}>
            <Icon name="download" size={16} /><span><strong>{s.kml}</strong><small>{s.kmlHint}</small></span>
          </a>
          <a class="btn" href={googleStages} target="_blank" rel="noopener" title={s.openStagesHint}>
            <Icon name="external" size={16} /><span><strong>{s.openStages}</strong><small>{s.openStagesHint}</small></span>
          </a>
          <button type="button" class="btn" data-copy={allCoords} data-done={s.copied} title={s.copyAllHint}>
            <Icon name="copy" size={16} /><span><strong>{s.copyAll}</strong><small>{s.copyAllHint}</small></span>
          </button>
        </div>
      </div>

      <div class="trip-map">
        <SheetMap id="trip-map" lang={lang} variant="trip" label={s.tripMap} routes={routes} points={points} />
      </div>
    </div>

    <IndexStrip
      label={s.regionsNav}
      show={s.showOnMap}
      go={s.goToSection}
      cells={data.regions.map((r, i) => ({ id: r.id, n: idx(i + 1), meta: dayRange(lang, r.days), name: r.name[lang], href: `#${r.id}` }))}
    />

    <article class="prose">
      <Content components={{ Before, Region, Day, Photo, Plates, Pair, Tip, Review, Good, Redo, Place }} />
    </article>

    {
      (older || newer) && (
        <nav class="pager" aria-label={s.trips}>
          {older && <a href={tripUrl(lang, older.slug)} rel="prev"><span class="label">{s.previous}</span>{older.title}</a>}
          {newer && <a href={tripUrl(lang, newer.slug)} rel="next"><span class="label">{s.next}</span>{newer.title}</a>}
        </nav>
      )
    }
  </main>

  <Foot lang={lang} href={`${base}/${lang}/`} label={s.allTrips} />
</BaseLayout>

<style>
  .top {
    display: grid;
    grid-template-columns: minmax(0, 1.75fr) minmax(360px, 1fr);
    grid-template-areas: 'plate cartouche' 'plate legend' 'map map';
    grid-template-rows: auto 1fr auto;
    border-bottom: 1px solid var(--ink);
    background: var(--paper);
  }
  .top.portrait { grid-template-columns: minmax(0, 1fr) minmax(360px, 1.35fr); }
  .top > * { min-width: 0; }
  .hero-plate { grid-area: plate; padding: var(--pad); border-right: 1px solid var(--ink); }
  .hero-plate :global(.plate) { margin: 0; }
  .top.portrait .hero-plate :global(img) { max-height: 74vh; width: auto; margin-inline: auto; }
  .cartouche { grid-area: cartouche; padding: var(--pad) var(--pad) 18px; border-bottom: 1px solid var(--ink); }
  .cartouche h1 { font-size: clamp(2rem, 1.4rem + 1.6vw, 2.75rem); }
  .lede { margin: 0.8rem 0 1rem; color: var(--ink-2); font-size: 1rem; line-height: 1.55; max-width: 52ch; }
  .facts { margin: 0; display: grid; grid-template-columns: repeat(4, auto); justify-content: space-between; gap: 0 18px; border-top: 1px solid var(--hair); padding-top: 10px; }
  .facts dt { color: var(--ink-3); font-size: 11px; }
  /* When the sheet was written and last revised: how fresh the information is, under the facts. */
  .stamp { margin: 10px 0 0; color: var(--ink-3); font-size: 13px; line-height: 1.4; }
  .stamp time { color: var(--ink-2); font-weight: 600; }
  .stamp .sep { display: inline-block; width: 3px; height: 3px; margin: 0 8px; border-radius: 50%; background: currentColor; vertical-align: 0.28em; }
  .facts dd { margin: 2px 0 0; font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }
  /* Who and how much: a second row of the same ledger, the cost taking the rest of the row for its note. */
  .facts > div:nth-child(n + 5) { margin-top: 10px; }
  .facts .cost { grid-column: span 3; }
  .facts .note { margin-left: 8px; color: var(--ink-3); font-size: 13px; font-weight: 400; }
  .legend { grid-area: legend; padding: 16px var(--pad) var(--pad); }
  .legend h2 { font-size: 11px; color: var(--ink-3); margin-bottom: 8px; }
  .legend .take { margin-top: 16px; }
  .symbols { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 14px; }
  .symbols li { display: flex; align-items: center; gap: 8px; }
  .sym { display: inline-grid; place-items: center; width: 24px; flex: none; color: var(--ink); }
  .sym.route { height: 4px; background: var(--gold); }
  .sym.approx { height: 3px; background: repeating-linear-gradient(90deg, var(--gold) 0 3px, transparent 3px 9px); }
  .symbols .badge { margin-inline: 1px; }
  .sym.detour::before { content: ''; width: 12px; height: 12px; box-sizing: border-box; border: 2px solid var(--ink); border-radius: 50%; }
  .exports { display: grid; grid-template-columns: 1fr 1fr; grid-auto-rows: 1fr; gap: 6px; }
  .btn {
    display: flex; align-items: center; gap: 10px; padding: 8px 12px; border: 1px solid var(--ink);
    background: var(--paper); color: var(--ink); font: inherit; text-align: left; cursor: pointer; text-decoration: none;
    transition: background-color 160ms cubic-bezier(0.16, 1, 0.3, 1), color 160ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .btn:hover { background: var(--ink); color: var(--paper); }
  .btn:hover small { color: rgb(255 255 255 / 0.75); }
  .btn span { display: grid; line-height: 1.2; }
  .btn strong { font-size: 14px; }
  .btn small { color: var(--ink-3); font-size: 13px; line-height: 1.3; }
  .btn.done strong::after { content: ' · ' attr(data-done); color: var(--gold-ink); }
  .btn.done:hover strong::after { color: var(--paper); }
  .trip-map { grid-area: map; border-top: 1px solid var(--ink); }
  .trip-map :global(.sheet-map.trip) { height: clamp(300px, 40vh, 440px); }

  .prose { padding-bottom: var(--gap-section); }
  /* The trip's opening text: a panel at the reading measure, centred under the regions index. */
  .prose > :global(:is(p, ul, ol)) { margin-left: calc((100% - var(--wide)) / 2); }
  .prose > :global(p:first-child) { margin-top: calc(3 * var(--grid-unit)); color: var(--ink-3); font-size: 14px; }

  .pager { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--ink); background: var(--paper); }
  .pager a { display: grid; gap: 4px; padding: 20px var(--pad); text-decoration: none; font-weight: 700; }
  .pager a[rel='next'] { text-align: right; grid-column: 2; border-left: 1px solid var(--hair); }
  .pager .label { color: var(--ink-3); font-size: 11px; }

  @media (max-width: 960px) {
    /* Phone order: the trip's name, then the photo with the map right below it, then the facts and exports. */
    .top, .top.portrait { grid-template-columns: 1fr; grid-template-areas: 'title' 'plate' 'map' 'summary' 'legend'; grid-template-rows: auto; }
    .cartouche { display: contents; }
    .cartouche h1 { grid-area: title; padding: 18px var(--pad) 0; }
    .summary { grid-area: summary; padding: var(--pad) var(--pad) 18px; border-bottom: 1px solid var(--ink); }
    .summary .lede { margin-top: 0; }
    .hero-plate { border-right: 0; }
    .trip-map { border-bottom: 1px solid var(--ink); }
    .hero-plate :global(.plate) { margin: 0; }
    .top.portrait .hero-plate :global(img) { max-height: none; width: 100%; }
    .exports { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .exports { grid-template-columns: 1fr; }
  }
  /* The four figures need about 425px on one row: a narrower cartouche (a phone, or the 1100–1400px desktop where its
     column is near its minimum) sets them two by two. */
  .summary { container-type: inline-size; }
  @container (max-width: 424px) {
    .facts { grid-template-columns: 1fr 1fr; gap: 10px 18px; }
    .facts > div:nth-child(n + 5) { margin-top: 0; }
    .facts .cost { grid-column: auto; }
    /* In a half-width cell the note goes under the amount, so the cell never widens the column. */
    .facts .note { display: block; margin: 0; }
  }
</style>

<script>
  import { watchSheet } from '../../../scripts/sheet-grid';
  import { stampBoxes } from '../../../scripts/box-uids';
  import { stickHeads } from '../../../scripts/sticky-heads';
  // References first: their labels sit inside the boxes' padding, so the sheet walk measures the final layout.
  stampBoxes();
  watchSheet();
  stickHeads();

  // Copy buttons anywhere on the page, map popups included (capture phase: Leaflet stops click bubbling in popups).
  async function copy(text: string) {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const area = Object.assign(document.createElement('textarea'), { value: text });
      area.style.cssText = 'position:fixed;opacity:0';
      document.body.append(area);
      area.select();
      const ok = document.execCommand('copy');
      area.remove();
      return ok;
    }
  }
  document.addEventListener(
    'click',
    async (e) => {
      const btn = (e.target as Element).closest<HTMLButtonElement>('button[data-copy]');
      if (!btn) return;
      const text = btn.dataset.copy!;
      const announce = document.getElementById('announce');
      if (await copy(text)) {
        btn.classList.add('done');
        if (announce) announce.textContent = `${btn.dataset.done} — ${text.split('\n')[0]}${text.includes('\n') ? '…' : ''}`;
        setTimeout(() => btn.classList.remove('done'), 1800);
      } else {
        // No clipboard at all: select what is visible and say how to copy it.
        getSelection()?.selectAllChildren(btn.querySelector('.ll') ?? btn);
        btn.classList.add('failed');
        if (announce) announce.textContent = document.documentElement.dataset.copyFallback ?? '';
      }
    },
    true,
  );
</script>
