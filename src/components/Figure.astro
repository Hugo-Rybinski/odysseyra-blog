---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}
const { src, alt, caption } = Astro.props;
---

<figure>
  <Image src={src} alt={alt} widths={[480, 800, 1200]} sizes="(min-width: 64rem) 64rem, 100vw" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  figure { margin: 2rem -1rem; }
  figcaption { font: 0.85rem system-ui, sans-serif; color: var(--muted); padding: 0.5rem 1rem 0; }
</style>
