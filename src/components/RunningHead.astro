---
import { base, homeUrl, t, otherLang, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** URL of this page in the other language; the script keeps the reader's current region in the hash. */
  otherHref: string;
  sheet?: string;
  coords?: string;
}
const { lang, otherHref, sheet, coords } = Astro.props;
const s = t(lang);
const other = otherLang(lang);
---

<header class="rhead">
  <a class="brand" href={homeUrl(lang)}>
    <img src={`${base}/logo.svg`} alt="" width="30" height="30" />
    <span>Odysseyra</span>
  </a>
  {sheet && <p class="label sheet-no"><a href="#top">{sheet.split(' · ').map((part, i) => <>{i > 0 && <> <i class="sep" aria-hidden="true"></i> </>}{part}</>)}</a></p>}
  <nav class="langs label" aria-label="Langue / Language">
    <span aria-current="true">{lang.toUpperCase()}</span>
    <span aria-hidden="true">/</span>
    <a href={otherHref} hreflang={other} lang={other} data-keep-place>{s.otherLangShort}<span class="visually-hidden"> — {s.otherLang}</span></a>
  </nav>
  {coords && <p class="data coords">{coords}</p>}
</header>

<style>
  .rhead {
    display: grid; grid-template-columns: auto 1fr auto auto; align-items: center; gap: 12px 28px;
    padding: 12px var(--pad); border-bottom: 1px solid var(--ink); background: var(--paper);
    /* The page's running title: it stays at the top of the window all the way down (sticky-heads.ts). */
    position: sticky; top: 0; z-index: 30;
  }
  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; font-size: 14px; }
  .sheet-no { margin: 0; color: var(--ink-3); }
  /* The sheet's title goes back to the top of the sheet. */
  .sheet-no a { color: inherit; text-decoration: none; }
  .sheet-no a:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  @media (pointer: coarse) { .sheet-no a { display: inline-flex; align-items: center; min-height: 44px; } }
  /* Its own column, so it stays on the right on a page with no sheet title (the missing sheet). */
  .langs { display: flex; gap: 8px; grid-column: 3; }
  .langs [aria-current] { color: var(--ink); }
  .langs a { color: var(--ink-3); text-decoration: none; }
  @media (pointer: coarse) {
    .brand { min-height: 44px; }
    .langs { align-items: center; }
    .langs a { display: inline-grid; place-items: center; min-width: 44px; min-height: 44px; margin: -12px -12px -12px -8px; }
  }
  .langs a:hover { color: var(--gold-ink); }
  .coords { margin: 0; color: var(--ink-3); }
  @media (max-width: 640px) {
    .rhead { grid-template-columns: 1fr auto; gap: 6px 16px; }
    .langs { grid-column: 2; }
    .sheet-no { grid-row: 2; font-size: 11px; }
    .coords { grid-row: 2; font-size: 11px; }
  }
</style>

<script>
  // Switching language keeps the reader at the same region: ids are shared across languages.
  const link = document.querySelector<HTMLAnchorElement>('a[data-keep-place]');
  const sections = [...document.querySelectorAll<HTMLElement>('section.before, section.region')];
  if (link && sections.length) {
    const baseHref = link.href.split('#')[0];
    const update = () => {
      const current = sections.filter((s) => s.getBoundingClientRect().top < innerHeight * 0.4).pop();
      link.href = current ? `${baseHref}#${current.id}` : baseHref;
    };
    addEventListener('scroll', update, { passive: true });
    update();
  }
</script>
