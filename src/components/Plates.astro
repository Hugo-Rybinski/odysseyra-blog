---
/** Lays photos out side by side: portraits pair up, a landscape takes the full row. Never crops. */
---

<div class="plates"><slot /></div>

<style>
  .plates {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: start;
    width: min(960px, 100vw - 2 * var(--pad) - 2 * var(--sheet-pad));
    margin: 2.5rem 0;
    position: relative;
    left: 50%;
    transform: translateX(-50%);
  }
  .plates :global(.plate) { margin: 0; }
  .plates :global(.plate.landscape) { grid-column: 1 / -1; }
  @media (max-width: 640px) {
    .plates { grid-template-columns: 1fr; }
  }
</style>
