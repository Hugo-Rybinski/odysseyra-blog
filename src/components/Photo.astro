---
import { Image } from 'astro:assets';
import { t } from '../i18n';
import type { TripView } from '../lib/trips';

interface Props {
  id: string;
  loading?: 'lazy' | 'eager';
  /** The trip the photo belongs to; inside a trip page, the page's own. */
  trip?: TripView;
}
const { id, loading = 'lazy' } = Astro.props;
const trip = Astro.props.trip ?? Astro.locals.trip;
if (!trip) throw new Error('<Photo> needs a trip: render it inside a trip page or pass `trip`');
const photo = trip.photos.get(id);
if (!photo) throw new Error(`[${trip.slug}] <Photo id="${id}">: no such photo in trip.yaml`);
const s = t(trip.lang);
const { image, orientation, exif } = photo;
const settings = [exif.aperture, exif.shutter, exif.iso, exif.focal].filter(Boolean);
const gear = [exif.camera, exif.lens].filter(Boolean);
const widths = orientation === 'landscape' ? [640, 960, 1440, 1920] : [480, 720, 960, 1280];
const sizes =
  orientation === 'landscape'
    ? '(min-width: 1100px) 960px, 100vw'
    : '(min-width: 1100px) 470px, (min-width: 640px) 50vw, 100vw';
const plateNo = String(photo.plate).padStart(2, '0');
---

<figure class:list={['plate', orientation]}>
  <a class="frame" href={image.src} aria-label={`${s.original} — ${photo.alt}`}>
    <Image src={image} alt={photo.alt} widths={widths} sizes={sizes} loading={loading} fetchpriority={loading === 'eager' ? 'high' : undefined} />
  </a>
  <figcaption>
    <p class="cap">
      <span class="label">{s.plate} {plateNo}</span>
      {photo.caption && <span class="text">{photo.caption}</span>}
    </p>
    {
      (settings.length > 0 || gear.length > 0) && (
        <p class="exif data">
          {settings.length > 0 && <span>{settings.join(' · ')}</span>}
          {gear.length > 0 && <span>{gear.join(' · ')}</span>}
        </p>
      )
    }
  </figcaption>
</figure>

<style>
  /* A mounted print: image (a link to the full-size file), plate number and caption in one white box with a light border. Border plus padding
     is exactly one grid square, so when the box sits on the grid, so does the image inside it. */
  .plate {
    margin: var(--gap) 0;
    padding: calc(var(--grid-unit) - 1px) calc(var(--grid-unit) - 1px) 0;
    border: 1px solid var(--hair-strong);
    background: var(--paper);
  }
  .frame { display: block; outline-offset: 4px; }
  .frame img { width: 100%; height: auto; background: var(--field); }
  figcaption { padding: 10px 0 9px; display: grid; gap: 4px; }
  .cap { margin: 0; display: flex; flex-wrap: wrap; gap: 4px 14px; align-items: baseline; font-size: 14px; line-height: 1.45; }
  .cap .label { color: var(--ink); }
  /* Under a wide plate the caption keeps the text panels' measure (about 75 characters a line, see --text-col). */
  .cap .text { max-width: 33em; color: var(--ink-2); }
  .exif { margin: 0; display: flex; flex-wrap: wrap; gap: 2px 16px; color: var(--ink-3); }
</style>

