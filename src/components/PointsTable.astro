---
import Icon from './Icon.astro';
import { badgeSpan, t, type Lang } from '../i18n';
import { formatLatLng } from '../lib/trips';
import type { MapPoint } from './SheetMap.astro';

interface Props {
  lang: Lang;
  points: MapPoint[];
}
const { lang, points } = Astro.props;
const s = t(lang);
// The number column fits the widest badge (a triple square for a place stayed at three separate times).
const span = Math.max(1, ...points.map((p) => (p.label ? badgeSpan(p.label) : 1)));
---

{
  points.length > 0 && (
    // A long list scrolls inside its box: the sheet walk caps it at seven rows (see sheet-grid.ts).
    <div class="points-wrap">
    <table class="points" style={`--badge-w: ${span * 22}px`}>
      <caption class="visually-hidden">{s.places}</caption>
      <thead>
        <tr>
          <th scope="col" class="n"><span class="visually-hidden">#</span></th>
          <th scope="col">{s.place}</th>
          <th scope="col">{s.coords}</th>
        </tr>
      </thead>
      <tbody>
        {points.map((p) => {
          const ll = formatLatLng(p.at);
          return (
            <tr id={`pt-${p.id}`} class={p.kind}>
              <td class="n">
                {p.label && (
                  <span class:list={['badge', p.kind === 'stage' ? 'stay' : 'stop']} style={`--span: ${badgeSpan(p.label)}`}>
                    <span>{p.label}</span>
                  </span>
                )}
              </td>
              <th scope="row">
              {p.name}
            </th>
              <td>
                <button type="button" class="copy data" data-copy={ll} data-done={s.copied} aria-label={`${s.copy} ${ll}`}>
                  <span class="ll">{ll}</span>
                  <Icon name="copy" size={15} />
                </button>
                <span class="go">
                <a href={`https://www.google.com/maps/search/?api=1&query=${p.at[0]},${p.at[1]}`} rel="noopener" target="_blank">{s.openGoogle}</a>
                <a href={`https://maps.apple.com/?ll=${p.at[0]},${p.at[1]}&q=${encodeURIComponent(p.name)}`} rel="noopener" target="_blank">{s.openApple}</a>
                </span>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
    </div>
  )
}

<style>
  .points { width: 100%; border-collapse: collapse; font-size: var(--step-0); line-height: 1.4; }
  .points-wrap { min-width: 0; overscroll-behavior: contain; }
  /* When it scrolls, a soft shade under the last visible row says there is more; a paper cover that scrolls with
     the content hides it once the end is reached. */
  .points-wrap[style*='overflow'] {
    background:
      linear-gradient(transparent, var(--paper) 60%) 0 100% / 100% 28px no-repeat local,
      linear-gradient(rgb(18 41 79 / 0), rgb(18 41 79 / 0.1)) 0 100% / 100% 14px no-repeat scroll;
  }
  /* The column heads stay in view when the list scrolls; their rule is drawn as a shadow so it travels with them. */
  .points thead th { position: sticky; top: 0; background: var(--paper); box-shadow: inset 0 -1px 0 var(--ink); }
  .points thead th {
    text-align: left; font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--ink-3); padding: 10px 12px; border-bottom: 1px solid transparent;
  }
  .points td, .points tbody th { padding: 8px 12px; border-bottom: 1px solid var(--hair); text-align: left; vertical-align: middle; }
  .points tbody th { font-weight: 600; }
  .points tr:target { animation: located 2.4s cubic-bezier(0.16, 1, 0.3, 1); }
  @keyframes located { from { background: var(--gold-wash); } to { background: transparent; } }
  @media (prefers-reduced-motion: reduce) { .points tr:target { animation: none; background: var(--field); } }
  .n { width: var(--badge-w); white-space: nowrap; }
  .copy {
    display: inline-flex; align-items: center; gap: 8px; padding: 4px 6px; margin: -4px -6px;
    border: 0; background: none; color: var(--ink); cursor: pointer;
  }
  .copy .ll { white-space: nowrap; }
  .copy .icon { color: var(--ink-3); }
  .copy:hover .icon, .copy.done .icon { color: var(--gold-ink); }
  .copy.done::after { content: attr(data-done); font-family: var(--sans); font-weight: 700; color: var(--gold-ink); }
  .go { display: flex; gap: 14px; margin-top: 2px; }
  .go a { font-size: 13px; font-weight: 600; color: var(--ink-2); }
  /* Touch: every action in the row gets a full finger-sized target. */
  @media (pointer: coarse) {
    .points td:last-child { display: flex; flex-wrap: wrap; align-items: center; column-gap: 10px; }
    .copy { min-height: 44px; margin-block: 0; }
    .go { gap: 0; margin-top: 0; }
    .go a { display: inline-flex; align-items: center; min-height: 44px; padding-inline: 4px 10px; }
    }
  @media (max-width: 720px) {
    .points thead { display: none; }
    .points tr { display: grid; grid-template-columns: calc(var(--badge-w) + 24px) 1fr; padding: 8px 0; border-bottom: 1px solid var(--hair); }
    .points td, .points tbody th { border: 0; padding: 2px 12px 2px 0; }
    .points td:not(.n) { grid-column: 2; }
    .points .n { grid-row: span 2; padding-left: 12px; }
  }
</style>
