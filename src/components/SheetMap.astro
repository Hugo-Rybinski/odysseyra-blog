---
import type { NumberedPoint } from '../lib/trips';
import { t, type Lang } from '../i18n';

export interface MapRoute {
  id: string;
  name: string;
  href: string;
  segments: { approx: boolean; path: [number, number][] }[];
}
export type MapPoint = NumberedPoint & {
  href: string;
  regionName: string;
  /** Tips attached to this point: links to their box in the text. */
  tips: { id: string; label: string }[];
};
interface Props {
  id: string;
  lang: Lang;
  label: string;
  routes: MapRoute[];
  points: MapPoint[];
  /** 'trip' routes are clickable and highlightable; 'region' is a detail view. */
  variant: 'trip' | 'region';
}
const { id, lang, label, routes, points, variant } = Astro.props;
const s = t(lang);
const strings = {
  goToRegion: s.goToRegion,
  readTip: s.readTip,
  showAll: s.showAll,
  onMap: s.onMap,
  explore: s.explore,
  exploreDone: s.exploreDone,
  credits: s.credits,
  copy: s.copy,
  copied: s.copied,
  kinds: { stage: s.legendStage, sight: s.legendSight, detour: s.legendDetour },
};
const config = JSON.stringify({ routes, points, variant, strings });
---

<div class:list={['sheet-map', variant]} id={id} data-map={config} role="region" aria-label={label}>
  <noscript>
    <ol class="fallback">
      {points.map((p) => <li><a href={p.href}>{p.ref}{p.name}</a> <span class="data">{p.at.join(', ')}</span></li>)}
    </ol>
  </noscript>
</div>

<style>
  .sheet-map {
    position: relative;
    z-index: 0;
    width: 100%;
    /* Flush outline: drawn just outside the map, so it overlaps (never doubles) the ruled box edges it touches. */
    outline: 1px solid var(--ink);
    outline-offset: 0;
    background:
      repeating-linear-gradient(0deg, var(--hair) 0 1px, transparent 1px 40px),
      repeating-linear-gradient(90deg, var(--hair) 0 1px, transparent 1px 40px),
      var(--field);
  }
  .trip { height: clamp(320px, 42vh, 460px); }
  .region { height: clamp(260px, 34vh, 360px); }

  /* The map printed on real paper, then scanned: a seamless paper texture (soft unevenness, fibre tooth; no creases),
     multiplied for its shadows and screened for its lit side. It sits over the tiles and the route (printed things)
     and under markers, popups and controls (the reader's tools), and is pinned to the map: it travels with the tiles. */
  .sheet-map :global(.fold) {
    pointer-events: none;
    background-repeat: repeat;
    background-size: 600px 400px;
    background-position: var(--fold-x, 0px) var(--fold-y, 0px);
  }
  .sheet-map :global(.fold-shade) { mix-blend-mode: multiply; }
  .sheet-map :global(.fold-lit) { mix-blend-mode: screen; }
  .fallback { margin: 0; padding: 16px 16px 16px 36px; font-size: 14px; }
  .sheet-map :global(.leaflet-container) { font: inherit; background: var(--field); }
  .sheet-map :global(.leaflet-tile-pane) { filter: grayscale(1) sepia(0.35) hue-rotate(180deg) saturate(1.4) contrast(0.7) brightness(1.18); }
  /* Tiles overlap by half a pixel: the filter otherwise leaves hairline seams between them. */
  .sheet-map :global(.leaflet-tile) { width: 256.5px !important; height: 256.5px !important; }
  /* Map credits folded behind an "i": the licence notice stays one click away without printing over the sheet. */
  .sheet-map :global(.credits) { display: flex; flex-direction: row-reverse; align-items: stretch; }
  .sheet-map :global(.credits-toggle) {
    position: relative; flex: none; width: 22px; height: 22px; padding: 0; border: 0; border-left: 1px solid var(--ink); border-top: 1px solid var(--ink);
    background: var(--paper); color: var(--ink); font: italic 700 13px/1 Georgia, serif; cursor: pointer;
  }
  /* A 44px hit area on touch, without growing the drawn square. */
  .sheet-map :global(.credits-toggle::after) { content: ''; position: absolute; right: 0; bottom: 0; width: 44px; height: 44px; }
  .sheet-map :global(.credits-toggle:hover), .sheet-map :global(.credits-toggle[aria-expanded='true']) { background: var(--ink); color: var(--paper); }
  .sheet-map :global(.credits .leaflet-control-attribution) {
    display: none; float: none; margin: 0; align-content: center;
    font: 400 11px/1.4 var(--sans); color: var(--ink-3); background: var(--paper); border-top: 1px solid var(--ink); border-left: 1px solid var(--ink); padding: 3px 6px;
  }
  .sheet-map :global(.credits.is-open .leaflet-control-attribution) { display: block; }
  .sheet-map :global(.leaflet-control-zoom a) { color: var(--ink); border-radius: 0; }
  .sheet-map :global(.leaflet-bar) { border: 1px solid var(--ink); border-radius: 0; box-shadow: none; }
  .sheet-map :global(.leaflet-popup-content-wrapper), .sheet-map :global(.leaflet-popup-tip), .sheet-map :global(.leaflet-control-zoom a) { background: var(--paper); }
  .sheet-map :global(.leaflet-popup-content-wrapper) { border-radius: 0; border: 1px solid var(--ink); box-shadow: 0 6px 18px rgb(18 41 79 / 0.14); }
  .sheet-map :global(.leaflet-popup-tip) { border: 1px solid var(--ink); box-shadow: none; }
  .sheet-map :global(.leaflet-popup-content) { margin: 12px 16px; font-size: 14px; line-height: 1.4; color: var(--ink); display: grid; gap: 6px; min-width: 200px; }
  .sheet-map :global(.leaflet-popup-content p) { margin: 0; }
  .sheet-map :global(.leaflet-popup-content a) { color: var(--ink); font-weight: 600; }
  .sheet-map :global(.pop-kind) { color: var(--ink-3); font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .sheet-map :global(.pop-copy) {
    justify-self: start; display: inline-flex; gap: 8px; align-items: center; padding: 4px 8px; margin-left: -8px;
    border: 0; background: none; color: var(--ink); font: 400 13px/1.3 var(--mono); cursor: pointer;
  }
  .sheet-map :global(.pop-copy:hover) { background: var(--field); }
  .sheet-map :global(.pop-copy.done::after) { content: attr(data-done); font: 700 13px/1 var(--sans); color: var(--gold-ink); }
  .sheet-map :global(.graticule) { position: absolute; inset: 0; z-index: 500; pointer-events: none; overflow: hidden; }
  .sheet-map :global(.tick) {
    position: absolute; font: 400 11px/1 var(--mono); color: var(--ink); background: color-mix(in srgb, var(--paper) 92%, transparent); padding: 2px 3px;
    font-variant-numeric: tabular-nums;
  }
  .sheet-map :global(.tick.x) { top: 0; transform: translateX(-50%); border-left: 1px solid var(--ink); border-right: 0; }
  .sheet-map :global(.tick.y) { right: 0; transform: translateY(-50%); border-top: 1px solid var(--ink); }
  .sheet-map :global(.leaflet-top.leaflet-left) { top: 18px; }
  .sheet-map :global(.leaflet-top.leaflet-right) { top: 24px; right: 44px; }
  /* One strip along the bottom edge, left to right: the scale, the "i" (its credits unfold between the two), and the
     map's box reference in the corner, like every other box's. Leaflet stacks bottom controls newest first, so the
     order is set here. */
  .sheet-map :global(.leaflet-bottom.leaflet-right) { display: flex; align-items: flex-end; }
  .sheet-map :global(.leaflet-bottom.leaflet-right .leaflet-control) { margin: 0; }
  .sheet-map :global(.leaflet-bottom.leaflet-right .leaflet-control-scale) { order: 0; }
  .sheet-map :global(.leaflet-bottom.leaflet-right .credits) { order: 1; }
  .sheet-map :global(.leaflet-bottom.leaflet-right .uid) { order: 2; }
  /* The ruler's right end is the "i"'s left rule. */
  .sheet-map :global(.leaflet-control-scale-line) {
    height: 22px; padding: 0 6px; border: 1px solid var(--ink); border-right: 0; border-bottom: 0;
    background: var(--paper); color: var(--ink); font: 400 11px/21px var(--mono); text-shadow: none;
  }

  /* Markers. The inner box carries the look; the outer Leaflet element only positions it, so overlap nudges stay smooth. */
  .sheet-map :global(.pin) { background: none; border: 0; }
  /* Centred on the point whatever its size: a single, double or triple square, a circle, a ring. */
  .sheet-map :global(.pin > b) {
    position: relative; display: grid; place-items: center;
    transform: translate(calc(12px - 50% + var(--dx, 0px)), calc(12px - 50% + var(--dy, 0px)));
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  /* On the map, a paper ring keeps the ink square readable over any tile. */
  .sheet-map :global(.pin > .badge) { font-size: 12px; box-shadow: 0 1px 3px rgb(18 41 79 / 0.35); }
  .sheet-map :global(.pin > .badge.stay) { --u: 26px; border: 2px solid var(--paper); }
  .sheet-map :global(.pin > .badge.stop) { --u: 24px; }
  /* Overpass's middle dot has almost no advance width and spills right: draw the separator instead, at cap centre. */
  .sheet-map :global(.badge .sep) { display: inline-block; width: 3px; height: 3px; margin: 0 5px; border-radius: 50%; background: currentColor; vertical-align: calc(0.35em - 1.5px); }
  /* A detour or a place along the way: a small open ring, no number; quieter than a stop, findable all the same. */
  .sheet-map :global(.pin > .dot) {
    box-sizing: border-box; width: 12px; height: 12px; border: 2px solid var(--ink); border-radius: 50%; background: var(--paper);
    box-shadow: 0 0 0 1.5px var(--paper), 0 1px 3px rgb(18 41 79 / 0.35);
  }
  .sheet-map :global(.pin.is-active > b) { outline: 2px solid var(--gold); outline-offset: 2px; }
  .sheet-map :global(.pin.is-dim) { opacity: 0.4; }

  /* Region caption + reset, and the touch "explore" switch. */
  .sheet-map :global(.map-note) {
    display: flex; align-items: center; gap: 4px; margin: 0; background: var(--paper); border: 1px solid var(--ink);
    font: 600 13px/1.2 var(--sans); color: var(--ink); max-width: min(420px, 70vw);
  }
  .sheet-map :global(.map-note[hidden]) { display: none; }
  .sheet-map :global(.map-note span) { padding: 8px 4px 8px 10px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sheet-map :global(.map-note .k) { flex: none; color: var(--ink-3); font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; padding-right: 0; }
  .sheet-map :global(.map-note button), .sheet-map :global(.explore) {
    min-height: 36px; padding: 0 12px; border: 0; border-left: 1px solid var(--hair); background: none; color: var(--ink);
    font: 700 13px/1 var(--sans); cursor: pointer; white-space: nowrap;
  }
  .sheet-map :global(.map-note button:hover), .sheet-map :global(.explore:hover) { background: var(--ink); color: var(--paper); }
  .sheet-map :global(.explore) { min-height: 44px; border: 1px solid var(--ink); background: var(--paper); }
  .sheet-map :global(.explore[aria-pressed='true']) { background: var(--ink); color: var(--paper); }
</style>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import foldShade from '../assets/textures/fold-shade.webp?url';
  import foldLit from '../assets/textures/fold-lit.webp?url';
  import { badgeSpan, nightsLabel } from '../i18n';

  type Kind = 'stage' | 'sight' | 'detour';
  type Pt = { id: string; n: number; label: string; nights?: number[]; ref: string; kind: Kind; name: string; at: [number, number]; regionId: string; regionName: string; href: string; tips: { id: string; label: string }[] };
  type Route = { id: string; name: string; href: string; segments: { approx: boolean; path: [number, number][] }[] };
  type Strings = { goToRegion: string; readTip: string; showAll: string; onMap: string; explore: string; exploreDone: string; credits: string; copy: string; copied: string; kinds: Record<Kind, string> };

  const css = getComputedStyle(document.documentElement);
  const GOLD = css.getPropertyValue('--gold').trim() || '#b08d3e';
  const INK = css.getPropertyValue('--ink').trim() || '#12294f';
  const PAPER = css.getPropertyValue('--paper').trim() || '#ffffff';
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const touch = matchMedia('(pointer: coarse)').matches;
  const esc = (v: string) => v.replace(/[<>&"]/g, (c) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;', '"': '&quot;' })[c]!);


  // Points at the same spot (Bishkek, start and finish) share one marker: "01–02 · 14".
  function group(points: Pt[]) {
    const groups = new Map<string, Pt[]>();
    for (const p of points) {
      const key = `${p.at[0].toFixed(3)},${p.at[1].toFixed(3)}`;
      groups.set(key, [...(groups.get(key) ?? []), p]);
    }
    return [...groups.values()];
  }

  function icon(ps: Pt[]) {
    const p = ps[0];
    let html;
    if (p.kind === 'stage' || p.kind === 'sight') {
      // Stays on one spot merge their nights (Bishkek: "01–02 · 14", a triple square); stops list their numbers.
      const label = p.kind === 'stage' ? nightsLabel(ps.flatMap((q) => q.nights ?? [])) : ps.map((q) => q.label).join(' · ');
      html = `<b class="badge ${p.kind === 'stage' ? 'stay' : 'stop'}" style="--span:${badgeSpan(label)}"><span>${label.replaceAll(' · ', '<i class="sep"></i>')}</span></b>`;
    } else html = '<b class="dot"></b>';
    return L.divIcon({ className: `pin ${p.kind}`, html, iconSize: [24, 24], iconAnchor: [12, 12], popupAnchor: [0, -16] });
  }

  function popup(ps: Pt[], s: Strings, variant: 'trip' | 'region') {
    return ps
      .map((p) => {
        const ll = `${p.at[0].toFixed(5)}, ${p.at[1].toFixed(5)}`;
        const tips = p.tips.map((tip) => `<a class="pop-tip" href="#${tip.id}">${esc(s.readTip)} · ${esc(tip.label)}</a>`).join('');
        const region = variant === 'trip' ? `<a href="#${p.regionId}">${esc(s.goToRegion)} : ${esc(p.regionName)}</a>` : '';
        return `<p class="pop-kind">${esc(s.kinds[p.kind])}</p><p><strong>${p.ref}${esc(p.name)}</strong></p>
          <button type="button" class="pop-copy" data-copy="${ll}" data-done="${esc(s.copied)}" aria-label="${esc(s.copy)} ${ll}">${ll}</button>${tips}${region}`;
      })
      .join('<hr style="border:0;border-top:1px solid var(--hair);margin:4px 0">');
  }

  // Grid references on the frame, as on a survey sheet: whole or half degrees depending on the view.
  function graticule(el: HTMLElement, map: L.Map) {
    const layer = document.createElement('div');
    layer.className = 'graticule';
    layer.setAttribute('aria-hidden', 'true');
    el.appendChild(layer);
    const draw = () => {
      const b = map.getBounds();
      const span = Math.max(b.getEast() - b.getWest(), b.getNorth() - b.getSouth());
      const step = span > 6 ? 2 : span > 2 ? 1 : span > 0.8 ? 0.5 : span > 0.3 ? 0.2 : 0.1;
      const fmt = (v: number, pos: string, neg: string) => `${Math.abs(Number(v.toFixed(1)))}°${v >= 0 ? pos : neg}`;
      let html = '';
      for (let lng = Math.ceil(b.getWest() / step) * step; lng < b.getEast(); lng += step) {
        const x = map.latLngToContainerPoint([b.getNorth(), lng]).x;
        // Labels too close to the frame edge would be clipped: skip them.
        if (x < 28 || x > el.clientWidth - 28) continue;
        html += `<span class="tick x" style="left:${x}px">${fmt(lng, 'E', 'W')}</span>`;
      }
      for (let lat = Math.ceil(b.getSouth() / step) * step; lat < b.getNorth(); lat += step) {
        const y = map.latLngToContainerPoint([lat, b.getWest()]).y;
        if (y < 24 || y > el.clientHeight - 24) continue;
        html += `<span class="tick y" style="top:${y}px">${fmt(lat, 'N', 'S')}</span>`;
      }
      layer.innerHTML = html;
    };
    map.on('moveend zoomend resize', draw);
    draw();
  }

  // The paper sheet: a pane between the route (400) and the markers (600). The pane itself always covers the
  // frame; its texture is pinned to a point of the map, so panning drags the folds along with the tiles.
  function folds(map: L.Map) {
    // Each map shows a different, stable part of the sheet.
    const hash = [...map.getContainer().id].reduce((a, c) => (a * 31 + c.charCodeAt(0)) >>> 0, 7);
    const ox = hash % 600, oy = (hash >>> 10) % 400;
    const anchor = map.getCenter();
    const panes = (['shade', 'lit'] as const).map((name, i) => {
      const pane = map.createPane(`fold-${name}`);
      pane.classList.add('fold', `fold-${name}`);
      pane.style.zIndex = String(450 + i);
      pane.style.backgroundImage = `url(${name === 'shade' ? foldShade : foldLit})`;
      return pane;
    });
    const place = () => {
      const size = map.getSize();
      const pin = map.latLngToContainerPoint(anchor);
      for (const pane of panes) {
        L.DomUtil.setPosition(pane, map.containerPointToLayerPoint([0, 0]));
        pane.style.setProperty('--fold-x', `${Math.round(pin.x + ox)}px`);
        pane.style.setProperty('--fold-y', `${Math.round(pin.y + oy)}px`);
        pane.style.width = `${size.x}px`;
        pane.style.height = `${size.y}px`;
      }
    };
    map.on('move zoom viewreset zoomend resize', place);
    place();
  }

  // Markers closer than their own size are fanned out a few pixels so every number stays readable.
  function declutter(map: L.Map, markers: L.Marker[]) {
    const run = () => {
      const placed: { x: number; y: number; w: number }[] = [];
      for (const m of markers) {
        const el = m.getElement()?.firstElementChild as HTMLElement | null;
        if (!el) continue;
        const pt = map.latLngToLayerPoint(m.getLatLng());
        const w = Math.max(26, el.offsetWidth + 2);
        const hits = (dx: number, dy: number) => placed.some((q) => Math.abs(q.x - (pt.x + dx)) < (q.w + w) / 2 && Math.abs(q.y - (pt.y + dy)) < 26);
        let dx = 0, dy = 0, tries = 0;
        while (tries < 12 && hits(dx, dy)) {
          tries++;
          const angle = (tries * Math.PI) / 4 - Math.PI / 4;
          const r = 28 * Math.ceil(tries / 8) + (w - 26) / 2;
          dx = Math.round(Math.cos(angle) * r);
          dy = Math.round(Math.sin(angle) * Math.min(r, 30));
        }
        el.style.setProperty('--dx', `${dx}px`);
        el.style.setProperty('--dy', `${dy}px`);
        placed.push({ x: pt.x + dx, y: pt.y + dy, w });
      }
    };
    map.on('zoomend', run);
    run();
  }

  type Entry = { el: HTMLElement; map: L.Map; byPoint: Map<string, L.Marker>; fit: () => void; moved: boolean; groups: Map<string, L.FeatureGroup>; markers: Map<string, L.Marker[]>; all: L.LatLngBounds; note?: HTMLElement; names: Map<string, string> };
  const registry = new Map<string, Entry>();
  const fitOpts = (pad: number) => ({ paddingTopLeft: [pad + 28, pad] as [number, number], paddingBottomRight: [pad, pad] as [number, number], maxZoom: 11, duration: reduced ? 0 : 0.8 });

  function reset(entry: Entry) {
    entry.groups.forEach((g) => g.eachLayer((l) => (l as L.Polyline).setStyle?.({ opacity: (l as any).options.baseOpacity ?? 1 })));
    entry.markers.forEach((ms) => ms.forEach((m) => m.getElement()?.classList.remove('is-active', 'is-dim')));
    entry.map.flyToBounds(entry.all, fitOpts(36));
    entry.moved = false;
    if (entry.note) entry.note.hidden = true;
    entry.el.dispatchEvent(new CustomEvent('map:region', { bubbles: true, detail: null }));
  }

  function highlight(mapId: string, regionId: string) {
    const entry = registry.get(mapId);
    if (!entry) return;
    entry.moved = true;
    const bounds = L.latLngBounds([]);
    entry.groups.forEach((g, id) => {
      const on = id === regionId;
      g.eachLayer((l) => {
        const line = l as L.Polyline & { options: { baseOpacity?: number } };
        line.setStyle({ opacity: on ? line.options.baseOpacity ?? 1 : 0.25 });
      });
      if (on && g.getLayers().length) bounds.extend(g.getBounds());
    });
    entry.markers.forEach((ms, id) =>
      ms.forEach((m) => {
        const el = m.getElement();
        el?.classList.toggle('is-active', id === regionId);
        el?.classList.toggle('is-dim', id !== regionId);
        if (id === regionId) bounds.extend(m.getLatLng());
      }),
    );
    // A region with a single point (no track) still gets a view around it.
    if (bounds.isValid()) {
      if (bounds.getNorthEast().equals(bounds.getSouthWest())) entry.map.flyTo(bounds.getCenter(), 10, { duration: reduced ? 0 : 0.8 });
      else entry.map.flyToBounds(bounds, fitOpts(40));
    }
    if (entry.note) {
      entry.note.hidden = false;
      entry.note.querySelector('.name')!.textContent = entry.names.get(regionId) ?? '';
    }
    // Whoever asked (a region header's link, the regions index), the index marks the region shown.
    entry.el.dispatchEvent(new CustomEvent('map:region', { bubbles: true, detail: regionId }));
  }

  document.querySelectorAll<HTMLElement>('.sheet-map[data-map]').forEach((el) => {
    const { routes, points, variant, strings } = JSON.parse(el.dataset.map!) as { routes: Route[]; points: Pt[]; variant: 'trip' | 'region'; strings: Strings };
    // Touch screens: one finger scrolls the page until the reader asks to explore the map.
    const map = L.map(el, { scrollWheelZoom: false, dragging: !touch, zoomSnap: 0.25, attributionControl: true, keyboardPanDelta: 120 });
    L.tileLayer('https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png', {
      maxZoom: 17,
      subdomains: 'abc',
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>, SRTM · <a href="https://opentopomap.org">OpenTopoMap</a> (CC-BY-SA)',
    }).addTo(map);
    // Fold the attribution behind an "i" button. Leaflet rewrites the attribution's own innerHTML, so the button
    // lives beside it in a wrapper rather than inside it.
    const Credits = L.Control.extend({
      onAdd() {
        const box = L.DomUtil.create('div', 'credits');
        const text = map.attributionControl.getContainer()!;
        text.id = `${el.id}-credits`;
        const btn = L.DomUtil.create('button', 'credits-toggle', box) as HTMLButtonElement;
        btn.type = 'button';
        btn.textContent = 'i';
        btn.setAttribute('aria-label', strings.credits);
        btn.setAttribute('aria-expanded', 'false');
        btn.setAttribute('aria-controls', text.id);
        btn.addEventListener('click', () => {
          const open = box.classList.toggle('is-open');
          btn.setAttribute('aria-expanded', String(open));
        });
        box.appendChild(text);
        L.DomEvent.disableClickPropagation(box);
        return box;
      },
    });
    new Credits({ position: 'bottomright' }).addTo(map);

    const all = L.latLngBounds([]);
    const groups = new Map<string, L.FeatureGroup>();
    const names = new Map<string, string>();
    for (const r of routes) {
      names.set(r.id, r.name);
      const g = L.featureGroup();
      for (const seg of r.segments) {
        const style = { lineCap: 'round', lineJoin: 'round' } as const;
        if (seg.approx) {
          // Only the ends are known: a dashed gold line on a white underlay, no navy casing.
          L.polyline(seg.path, { ...style, color: PAPER, weight: 6, opacity: 0.9, interactive: false, baseOpacity: 0.9 } as L.PolylineOptions).addTo(g);
          L.polyline(seg.path, { ...style, color: GOLD, weight: 3, dashArray: '2 9', interactive: false, baseOpacity: 1 } as L.PolylineOptions).addTo(g);
        } else {
          // A navy casing under the gold line keeps the recorded route the strongest line over any tile.
          L.polyline(seg.path, { ...style, color: INK, weight: 7.5, opacity: 0.9, interactive: false, baseOpacity: 0.9 } as L.PolylineOptions).addTo(g);
          L.polyline(seg.path, { ...style, color: GOLD, weight: 3.5, interactive: false, baseOpacity: 1 } as L.PolylineOptions).addTo(g);
        }
      }
      if (variant === 'trip' && r.segments.length) {
        // An invisible, wider hit line per region: hover names it, click goes to its section.
        for (const seg of r.segments) {
          const hit = L.polyline(seg.path, { color: INK, weight: 16, opacity: 0, interactive: true }).addTo(map);
          hit.bindTooltip(r.name, { sticky: true });
          hit.on('click', () => (location.hash = r.href.split('#')[1] ?? ''));
          hit.on('add', () => hit.getElement()?.setAttribute('tabindex', '-1'));
          hit.getElement()?.setAttribute('tabindex', '-1');
        }
      }
      // Added once filled: a group joining the map before its lines confuses Leaflet's renderer order.
      g.addTo(map);
      groups.set(r.id, g);
      if (r.segments.length) all.extend(g.getBounds());
    }

    const markers = new Map<string, L.Marker[]>();
    const byPoint = new Map<string, L.Marker>();
    const allMarkers: L.Marker[] = [];
    for (const ps of group(points)) {
      const p = ps[0];
      const label = ps.map((q) => `${q.ref}${q.name}, ${strings.kinds[q.kind]}`).join(' ; ');
      // Not in the tab order: every point is listed, with the same actions, in the region tables.
      const m = L.marker(p.at, { icon: icon(ps), keyboard: false, title: label, alt: label, riseOnHover: true }).addTo(map);
      m.bindPopup(popup(ps, strings, variant));
      for (const q of ps) {
        markers.set(q.regionId, [...(markers.get(q.regionId) ?? []), m]);
        byPoint.set(q.id, m);
      }
      allMarkers.push(m);
      all.extend(p.at);
    }
    // Extra room on the left: the zoom buttons sit over that edge.
    const fit = () => (all.isValid() ? map.fitBounds(all, { paddingTopLeft: [64, 36], paddingBottomRight: [36, 36], maxZoom: 11, animate: false }) : map.setView([20, 0], 2));
    fit();
    L.control.scale({ imperial: false, position: 'bottomright' }).addTo(map);
    graticule(el, map);
    folds(map);
    declutter(map, allMarkers);

    const entry: Entry = { el, map, byPoint, fit, moved: false, groups, markers, all, names };
    // Once the reader has moved the map, a later resize keeps their view instead of re-fitting the route.
    map.on('dragstart', () => (entry.moved = true));
    el.querySelector('.leaflet-control-zoom')?.addEventListener('click', () => (entry.moved = true));
    if (variant === 'trip') {
      const Note = L.Control.extend({
        onAdd() {
          const box = L.DomUtil.create('p', 'map-note');
          box.hidden = true;
          box.innerHTML = `<span class="k">${esc(strings.onMap)}</span><span class="name"></span><button type="button">${esc(strings.showAll)}</button>`;
          box.querySelector('button')!.addEventListener('click', () => reset(entry));
          L.DomEvent.disableClickPropagation(box);
          return box;
        },
      });
      const note = new Note({ position: 'topright' });
      note.addTo(map);
      entry.note = note.getContainer();
    }
    if (touch) {
      const Explore = L.Control.extend({
        onAdd() {
          const btn = L.DomUtil.create('button', 'explore') as HTMLButtonElement;
          btn.type = 'button';
          btn.textContent = strings.explore;
          btn.setAttribute('aria-pressed', 'false');
          btn.addEventListener('click', () => {
            const on = !map.dragging.enabled();
            on ? map.dragging.enable() : map.dragging.disable();
            btn.setAttribute('aria-pressed', String(on));
            btn.textContent = on ? strings.exploreDone : strings.explore;
          });
          L.DomEvent.disableClickPropagation(btn);
          return btn;
        },
      });
      new Explore({ position: 'topright' }).addTo(map);
    }
    registry.set(el.id, entry);
    // Its controls exist from here on (the box reference joins the bottom strip, see box-uids.ts).
    el.dispatchEvent(new Event('sheetmap:ready'));
  });

  // The sheet grid walk resizes maps to land their outlines on the drafting grid: let Leaflet re-measure.
  // The walk can make a map much taller (phones): re-fit the route to the new frame unless the reader moved it.
  document.addEventListener('sheet:snapped', () =>
    registry.forEach((e) => {
      e.map.invalidateSize({ pan: false });
      if (!e.moved) e.fit();
    }),
  );

  // A place named in the text (<Place>): bring the map that shows it into view, its region map first (stops are only
  // there), then centre on it and open its card. The marker flashes the gold outline the region highlight uses.
  function locate(pointId: string) {
    const entries = [...registry.values()];
    const entry = entries.find((e) => e.el.classList.contains('region') && e.byPoint.has(pointId)) ?? entries.find((e) => e.byPoint.has(pointId));
    const marker = entry?.byPoint.get(pointId);
    if (!entry || !marker) return false;
    entry.moved = true;
    entry.el.scrollIntoView({ block: 'center', behavior: reduced ? 'auto' : 'smooth' });
    let done = false;
    const show = () => {
      if (done) return;
      done = true;
      entry.map.flyTo(marker.getLatLng(), Math.max(entry.map.getZoom(), 10), { duration: reduced ? 0 : 0.8 });
      entry.map.once('moveend', () => {
        marker.openPopup();
        const pin = marker.getElement();
        pin?.classList.add('is-active');
        setTimeout(() => pin?.classList.remove('is-active'), 2400);
      });
    };
    // Fly once the page has stopped scrolling, so the reader sees the move (or soon, if it was already in view).
    if ('onscrollend' in window) addEventListener('scrollend', show, { once: true });
    setTimeout(show, reduced ? 0 : 900);
    return true;
  }
  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('a[data-place]');
    if (a && locate(a.dataset.place!)) e.preventDefault();
  });

  // The regions index under the trip map: a cell shows its region on the map, pressed again the whole trip.
  const index = document.querySelector<HTMLElement>('.regions-index');
  if (index) {
    let current: string | null = null;
    index.addEventListener('click', (e) => {
      const cell = (e.target as Element).closest<HTMLElement>('li[data-region]');
      if (!cell || !(e.target as Element).closest('.pick')) return;
      const entry = registry.get('trip-map');
      if (!entry) return;
      if (cell.dataset.region === current) return reset(entry);
      // The map sits right above: the page stays where it is.
      highlight('trip-map', cell.dataset.region!);
    });
    document.addEventListener('map:region', (e) => {
      if ((e.target as HTMLElement).id !== 'trip-map') return;
      current = (e as CustomEvent<string | null>).detail;
      for (const li of index.querySelectorAll<HTMLElement>('li[data-region]')) {
        const on = li.dataset.region === current;
        li.classList.toggle('is-on', on);
        li.querySelector('.pick')?.setAttribute('aria-pressed', String(on));
      }
    });
  }

  // Signature cross-link: "show on the trip map" links light up their region on the trip map.
  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('a[data-highlight]');
    if (!a) return;
    const target = a.getAttribute('href')?.slice(1);
    if (target) setTimeout(() => highlight(target, a.dataset.highlight!), 350);
  });
</script>
