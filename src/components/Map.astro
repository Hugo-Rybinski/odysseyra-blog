---
/**
 * Interactive OpenStreetMap (Leaflet). Use in MDX posts:
 *   <Map markers={[{ lat: 38.71, lng: -9.14, label: 'Alfama' }]} route={[[38.71,-9.14],[38.69,-9.21]]} />
 */
interface Marker {
  lat: number;
  lng: number;
  label?: string;
}
interface Props {
  markers?: Marker[];
  /** Ordered [lat, lng] pairs drawn as a line (e.g. a hike or itinerary). */
  route?: [number, number][];
  zoom?: number;
  height?: string;
}
const { markers = [], route = [], zoom = 12, height = '24rem' } = Astro.props;
const config = JSON.stringify({ markers, route, zoom });
---

<div class="map" data-map={config} style={`height:${height}`} role="region" aria-label="Map"></div>

<style is:global>
  .map { margin: 2rem 0; border-radius: 0.5rem; z-index: 0; }
</style>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import iconUrl from 'leaflet/dist/images/marker-icon.png';
  import iconRetinaUrl from 'leaflet/dist/images/marker-icon-2x.png';
  import shadowUrl from 'leaflet/dist/images/marker-shadow.png';

  const icon = L.icon({
    iconUrl,
    iconRetinaUrl,
    shadowUrl,
    iconSize: [25, 41],
    iconAnchor: [12, 41],
    popupAnchor: [1, -34],
  });

  document.querySelectorAll<HTMLElement>('.map[data-map]').forEach((el) => {
    const { markers, route, zoom } = JSON.parse(el.dataset.map!);
    const map = L.map(el, { scrollWheelZoom: false });
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
    }).addTo(map);

    const points: L.LatLngTuple[] = [];
    for (const m of markers) {
      const marker = L.marker([m.lat, m.lng], { icon }).addTo(map);
      if (m.label) marker.bindPopup(m.label);
      points.push([m.lat, m.lng]);
    }
    if (route.length) {
      L.polyline(route, { color: '#c2410c', weight: 4 }).addTo(map);
      points.push(...route);
    }
    if (points.length > 1) map.fitBounds(L.latLngBounds(points), { padding: [30, 30] });
    else if (points.length === 1) map.setView(points[0], zoom);
    else map.setView([0, 0], 2);
  });
</script>
